{
  "//": "Copy to appsettings.Production.json on the server (git-ignored) and fill in. Secrets stay in the environment: EMAIL_PASSWORD, GOOGLE_APPLICATION_CREDENTIALS.",
  "Auth": { "Mode": "Firebase", "FirebaseProjectId": "your-firebase-project-id" },
  "Store": { "Mode": "Firestore" },
  "Firebase": { "CredentialFile": "/etc/ellp/service-account.json" },
  "Email": {
    "Host": "smtp.yourmail.example",
    "Port": 587,
    "AuthUser": "no-reply@yourschool.example",
    "Security": "starttls",
    "GlobalTestMode": true
  },
  "Cors": { "FrontendOrigin": "https://ellp.yourschool.example" }
}
