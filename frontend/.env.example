# ELLP frontend configuration (copy to .env.local). Never commit real secrets.

# true  = run on the built-in demo data (no Firebase, no API; progress is kept in this browser's localStorage)
# false = sign in with Firebase Auth and call the C# API
VITE_USE_DEMO=true

# Base path for the ELLP C# Web API (proxied in dev via vite.config.ts)
VITE_API_BASE=/api/v1
VITE_API_TARGET=http://localhost:5220

# Firebase web app config (Firebase console > Project settings > Your apps). Public values, not secrets,
# but keep them out of git anyway so each environment points at its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
